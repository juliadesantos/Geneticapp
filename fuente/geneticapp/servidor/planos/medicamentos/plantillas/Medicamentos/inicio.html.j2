{% extends "medicamentos/base.html.j2" %}

{% block titulo %}Medicamentos - GENETICAPP{% endblock %}

{% block contenido_plano %}

<header class="fila fila--entre margen-abajo-6">
    <div>
        <p class="texto-chico texto-gris">
            <a href="{{ url_for('inicio') }}"
               hx-get="{{ url_for('inicio') }}"
               hx-target="#contenido_principal"
               hx-select="#contenido_principal > *"
               hx-swap="innerHTML transition:true"
               hx-push-url="true">GENETICAPP</a> / MEDICAMENTOS</p>
        <h1 class="texto-titulo">Medicamentos</h1>
    </div>
    <a class="boton"
       href="{{ url_for('.nuevo') }}"
       hx-get="{{ url_for('.nuevo') }}"
       hx-target="#contenido_principal"
       hx-select="#contenido_principal > *"
       hx-swap="innerHTML transition:true"
       hx-push-url="true">+ Nuevo medicamento</a>
</header>

{% if medicamentos %}
<section class="grilla-auto">
    {% for medicamento in medicamentos %}
    <article class="caja columna">
        <div>
            <h2 class="texto-grande">{{ medicamento.nombre }}</h2>
            {% if medicamento.principio_activo %}
            <p class="texto-chico texto-gris margen-arriba-2">
                Principio activo: <span class="etiqueta">{{ medicamento.principio_activo }}</span>
            </p>
            {% endif %}
            {% if medicamento.dosis %}
            <p class="texto-chico texto-gris margen-arriba-2">Dosis: {{ medicamento.dosis }}</p>
            {% endif %}
        </div>
        <div class="fila margen-arriba-4">
            <a href="{{ url_for('.detalle', id=medicamento.id) }}"
               hx-get="{{ url_for('.detalle', id=medicamento.id) }}"
               hx-target="#contenido_principal"
               hx-select="#contenido_principal > *"
               hx-swap="innerHTML transition:true"
               hx-push-url="true"
               class="boton boton--secundario">Ver detalle</a>
            <a href="{{ url_for('.editar', id=medicamento.id) }}"
               hx-get="{{ url_for('.editar', id=medicamento.id) }}"
               hx-target="#contenido_principal"
               hx-select="#contenido_principal > *"
               hx-swap="innerHTML transition:true"
               hx-push-url="true"
               class="boton boton--secundario">Editar</a>
            <form method="POST"
                  action="{{ url_for('.eliminar', id=medicamento.id) }}"
                  style="display:inline">
                <button type="submit"
                        class="boton boton--peligro"
                        hx-confirm="¿Eliminar {{ medicamento.nombre }}? Esta acción no se puede deshacer."
                        hx-post="{{ url_for('.eliminar', id=medicamento.id) }}"
                        hx-target="#contenido_principal"
                        hx-select="#contenido_principal > *"
                        hx-swap="innerHTML transition:true"
                        hx-push-url="{{ url_for('.inicio') }}">Eliminar</button>
            </form>
        </div>
    </article>
    {% endfor %}
</section>
{% else %}
<section class="caja fila--centro columna espacio-8">
    <p class="texto-grande texto-gris">No hay medicamentos cargados aún.</p>
    <a class="boton"
       href="{{ url_for('.nuevo') }}"
       hx-get="{{ url_for('.nuevo') }}"
       hx-target="#contenido_principal"
       hx-select="#contenido_principal > *"
       hx-swap="innerHTML transition:true"
       hx-push-url="true">Cargar el primero</a>
</section>
{% endif %}

{% endblock %}
