{% extends "enfermedades/base.html.j2" %}

{% block titulo %}Editar {{ enfermedad.nombre }} - GENETICAPP{% endblock %}

{% block contenido_plano %}

<header class="margen-abajo-6">
    <p class="texto-chico texto-gris">
        <a href="{{ url_for('inicio') }}"
           hx-get="{{ url_for('inicio') }}"
           hx-target="#contenido_principal"
           hx-select="#contenido_principal > *"
           hx-swap="innerHTML transition:true"
           hx-push-url="true">GENETICAPP</a>
        /
        <a href="{{ url_for('.inicio') }}"
           hx-get="{{ url_for('.inicio') }}"
           hx-target="#contenido_principal"
           hx-select="#contenido_principal > *"
           hx-swap="innerHTML transition:true"
           hx-push-url="true">ENFERMEDADES</a>
        /
        <a href="{{ url_for('.detalle', id=enfermedad.id) }}"
           hx-get="{{ url_for('.detalle', id=enfermedad.id) }}"
           hx-target="#contenido_principal"
           hx-select="#contenido_principal > *"
           hx-swap="innerHTML transition:true"
           hx-push-url="true">{{ enfermedad.nombre | upper }}</a>
        / EDITAR
    </p>
    <h1 class="texto-titulo">Editar: {{ enfermedad.nombre }}</h1>
</header>

<form method="POST" action="{{ url_for('.editar', id=enfermedad.id) }}" class="caja columna">
    <div class="columna">
        <label for="nombre" class="texto-suave">Nombre <span class="texto-principal">*</span></label>
        <input type="text"
               id="nombre"
               name="nombre"
               class="campo"
               required
               value="{{ enfermedad.nombre }}">
    </div>

    <div class="columna">
        <label for="gen_afectado" class="texto-suave">Gen afectado</label>
        <input type="text"
               id="gen_afectado"
               name="gen_afectado"
               class="campo"
               value="{{ enfermedad.gen_afectado or '' }}">
    </div>

    <div class="columna">
        <label for="tipo_herencia" class="texto-suave">Tipo de herencia</label>
        <select id="tipo_herencia" name="tipo_herencia" class="campo">
            <option value="">— Seleccionar —</option>
            {% set tipos = [
                'Autosómica dominante',
                'Autosómica recesiva',
                'Ligada al X dominante',
                'Ligada al X recesiva',
                'Mitocondrial',
                'Multifactorial'
            ] %}
            {% for tipo in tipos %}
            <option value="{{ tipo }}" {% if enfermedad.tipo_herencia == tipo %}selected{% endif %}>{{ tipo }}</option>
            {% endfor %}
        </select>
    </div>

    <div class="columna">
        <label for="sintomas" class="texto-suave">Síntomas</label>
        <textarea id="sintomas"
                  name="sintomas"
                  class="campo"
                  rows="4">{{ enfermedad.sintomas or '' }}</textarea>
    </div>

    <div class="fila margen-arriba-4">
        <button type="submit" class="boton">Guardar cambios</button>
        <a href="{{ url_for('.detalle', id=enfermedad.id) }}"
           hx-get="{{ url_for('.detalle', id=enfermedad.id) }}"
           hx-target="#contenido_principal"
           hx-select="#contenido_principal > *"
           hx-swap="innerHTML transition:true"
           hx-push-url="true"
           class="boton boton--secundario">Cancelar</a>
    </div>
</form>

{% endblock %}
