{% extends "enfermedades/base.html.j2" %}

{% block titulo %}Enfermedades - GENETICAPP{% endblock %}

{% block contenido_plano %}

<header class="fila fila--entre margen-abajo-6">
    <div>
        <p class="texto-chico texto-gris">
            <a href="{{ url_for('inicio') }}"
               hx-get="{{ url_for('inicio') }}"
               hx-target="#contenido_principal"
               hx-select="#contenido_principal > *"
               hx-swap="innerHTML transition:true"
               hx-push-url="true">GENETICAPP</a> / ENFERMEDADES</p>
        <h1 class="texto-titulo">Enfermedades Genéticas</h1>
    </div>
    <a class="boton"
       href="{{ url_for('.nueva') }}"
       hx-get="{{ url_for('.nueva') }}"
       hx-target="#contenido_principal"
       hx-select="#contenido_principal > *"
       hx-swap="innerHTML transition:true"
       hx-push-url="true">+ Nueva enfermedad</a>
</header>

{% if enfermedades %}
<section class="grilla-auto">
    {% for enfermedad in enfermedades %}
    <article class="caja columna">
        <div>
            <h2 class="texto-grande">{{ enfermedad.nombre }}</h2>
            {% if enfermedad.gen_afectado %}
            <p class="texto-chico texto-gris margen-arriba-2">Gen: <span class="etiqueta">{{ enfermedad.gen_afectado }}</span></p>
            {% endif %}
            {% if enfermedad.tipo_herencia %}
            <p class="texto-chico texto-gris margen-arriba-2">Herencia: {{ enfermedad.tipo_herencia }}</p>
            {% endif %}
        </div>
        <div class="fila margen-arriba-4">
            <a href="{{ url_for('.detalle', id=enfermedad.id) }}"
               hx-get="{{ url_for('.detalle', id=enfermedad.id) }}"
               hx-target="#contenido_principal"
               hx-select="#contenido_principal > *"
               hx-swap="innerHTML transition:true"
               hx-push-url="true"
               class="boton boton--secundario">Ver detalle</a>
            <a href="{{ url_for('.editar', id=enfermedad.id) }}"
               hx-get="{{ url_for('.editar', id=enfermedad.id) }}"
               hx-target="#contenido_principal"
               hx-select="#contenido_principal > *"
               hx-swap="innerHTML transition:true"
               hx-push-url="true"
               class="boton boton--secundario">Editar</a>
            <form method="POST"
                  action="{{ url_for('.eliminar', id=enfermedad.id) }}"
                  style="display:inline">
                <button type="submit"
                        class="boton boton--peligro"
                        hx-confirm="¿Eliminar {{ enfermedad.nombre }}? Esta acción no se puede deshacer."
                        hx-post="{{ url_for('.eliminar', id=enfermedad.id) }}"
                        hx-target="#contenido_principal"
                        hx-select="#contenido_principal > *"
                        hx-swap="innerHTML transition:true"
                        hx-push-url="{{ url_for('.inicio') }}">Eliminar</button>
            </form>
        </div>
    </article>
    {% endfor %}
</section>
{% else %}
<section class="caja fila--centro columna espacio-8">
    <p class="texto-grande texto-gris">No hay enfermedades cargadas aún.</p>
    <a class="boton"
       href="{{ url_for('.nueva') }}"
       hx-get="{{ url_for('.nueva') }}"
       hx-target="#contenido_principal"
       hx-select="#contenido_principal > *"
       hx-swap="innerHTML transition:true"
       hx-push-url="true">Cargar la primera</a>
</section>
{% endif %}

{% endblock %}
