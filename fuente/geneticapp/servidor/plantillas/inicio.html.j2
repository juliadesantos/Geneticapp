{% extends "base.html.j2" %}

{% block titulo %}Inicio - GENETICAPP{% endblock %}

{% block css_secundario %}
{{ super() }}
<link rel="stylesheet" href="{{ url_for('static', filename='css/inicio.css') }}">
{% endblock %}

{% block contenido_principal %}
<section class="inicio__hero">
    <h1 class="inicio__hero-titulo">GeneticApp</h1>
    <p class="inicio__hero-descripcion">
        Base de consulta de enfermedades genéticas y sus tratamientos farmacológicos.
        Registrá enfermedades, sus genes afectados y los medicamentos asociados.
    </p>
</section>

<div class="inicio__contenedor">
    <div class="planos__grilla">
        <article class="plano">
            <h2 class="plano__titulo">Enfermedades</h2>
            <p class="plano__descripcion">
                Consultá y administrá enfermedades genéticas: gen afectado, tipo de herencia y síntomas.
            </p>
            <a class="plano__enlace"
               href="{{ url_for('geneticapp_servidor_planos_enfermedades.inicio') }}"
               hx-get="{{ url_for('geneticapp_servidor_planos_enfermedades.inicio') }}"
               hx-target="#contenido_principal"
               hx-select="#contenido_principal > *"
               hx-swap="innerHTML transition:true"
               hx-push-url="true">Ver enfermedades →</a>
        </article>

        <article class="plano">
            <h2 class="plano__titulo">Medicamentos</h2>
            <p class="plano__descripcion">
                Consultá y administrá medicamentos: principio activo, dosis y enfermedad asociada.
            </p>
            <a class="plano__enlace"
               href="{{ url_for('geneticapp_servidor_planos_medicamentos.inicio') }}"
               hx-get="{{ url_for('geneticapp_servidor_planos_medicamentos.inicio') }}"
               hx-target="#contenido_principal"
               hx-select="#contenido_principal > *"
               hx-swap="innerHTML transition:true"
               hx-push-url="true">Ver medicamentos →</a>
        </article>
    </div>
</div>
{% endblock %}

{% block js_secundario %}
{% endblock %}
